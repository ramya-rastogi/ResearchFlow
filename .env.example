# Required Search API Key
TAVILY_API_KEY=your_tavily_api_key_here

# LLM Provider Configuration ("mistral" or "groq")
LLM_PROVIDER=mistral

# Mistral Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b

# Groq Configuration (alternative)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Optional separate model for the critic agent
# CRITIC_MODEL=

# Pipeline Settings
MAX_REVISIONS=2
TRUST_THRESHOLD=90

# Persistence (Optional - runs in in-memory mode if unset or unreachable)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/researchflow

# CORS Settings
CORS_ORIGINS=http://localhost:5173
